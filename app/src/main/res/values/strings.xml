    <string name="dialog_permission_guide_title">System Permission Guide</string>
    <string name="dialog_permission_guide_msg">To enable wireless ADB and silent toggles, either grant Root permission via your root manager (Magisk / KernelSU / APatch), or execute the following ADB command via computer:\n\nadb shell pm grant com.xrsec.wifiadb android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="btn_copy_grant_cmd">Copy Command</string>
    <string name="grant_cmd_text">adb shell pm grant com.xrsec.wifiadb android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="toast_grant_cmd_copied">ADB grant command copied to clipboard</string>
    <string name="toast_root_success">Root permission acquired successfully!</string>
    <string name="dialog_dadb_port_title">Wireless Debugging Authorization</string>
    <string name="dialog_dadb_port_msg">Android 11+ has built-in Wireless Debugging. If enabled in Developer Options, please enter its assigned port (e.g. 38245). If not enabled, tap [Open Wireless Debugging] to turn it on.\n\nTip: If this app\'s Accessibility Service is enabled, the authorization prompt will be confirmed automatically.</string>
    <string name="btn_open_wireless_settings">Open Wireless Debugging</string>
    <string name="btn_start_auth">Authorize</string>
    <string name="progress_dadb_auth">Connecting to 127.0.0.1:%d for authorization…\nIf system dialog appears, Accessibility Service will auto-confirm; otherwise tap \"Always allow\" manually.</string>
    <string name="toast_cannot_open_settings">Cannot open Wireless Debugging settings</string>
    <string name="toast_port_not_listening">Port %d is not listening. Please ensure Wireless Debugging is active on this port!</string>
    <string name="dialog_a11y_prompt_title">Enable Accessibility Auto-Confirm?</string>
    <string name="dialog_a11y_prompt_msg">Accessibility Service is not enabled. With it, the app can automatically detect and confirm the debugging prompt for a true one-tap closed loop.\n\nWould you like to enable it now?</string>
    <string name="btn_go_to_a11y">Enable Accessibility</string>
    <string name="btn_continue_manual">Direct Grant</string>

